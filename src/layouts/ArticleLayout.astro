---
import SourceList from '@components/SourceList.astro';
import SlugLinkList from '@components/SlugLinkList.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

type LinkSection = {
  title: string;
  basePath: string;
  items: string[];
};

type MetaItem =
  | string
  | {
      label: string;
      value: string;
    };

type Props = {
  title: string;
  summary: string;
  eyebrow: string;
  status: string;
  lastReviewed: string;
  sourceIds: string[];
  metaItems?: MetaItem[];
  linkSections?: LinkSection[];
};

const {
  title,
  summary,
  eyebrow,
  status,
  lastReviewed,
  sourceIds,
  metaItems = [],
  linkSections = [],
} = Astro.props;

const normalizedMetaItems = metaItems.map((item) =>
  typeof item === 'string' ? { label: 'Context', value: item } : item,
);
const relatedLinkCount = linkSections.reduce(
  (total, section) => total + section.items.length,
  0,
);
const sourceLabel =
  sourceIds.length === 1
    ? '1 cited source'
    : `${sourceIds.length} cited sources`;
---

<BaseLayout title={title} description={summary}>
  <article class="article-shell">
    <header class="article-header">
      <div class="article-header__main">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="lede">{summary}</p>
      </div>
      <aside class="article-header__brief" aria-label="Article reading brief">
        <p class="eyebrow">Reading brief</p>
        <dl class="article-meta">
          <div>
            <dt>Status</dt>
            <dd>{status}</dd>
          </div>
          <div>
            <dt>Last reviewed</dt>
            <dd>{lastReviewed}</dd>
          </div>
          <div>
            <dt>Sources</dt>
            <dd>{sourceLabel}</dd>
          </div>
          <div>
            <dt>Related links</dt>
            <dd>{relatedLinkCount}</dd>
          </div>
          {
            normalizedMetaItems.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="article-header__neutrality">
          Systems first, examples second. Claims should stay tied to cited
          records and avoid rankings or buyer guidance.
        </p>
      </aside>
    </header>
    <div class="article-grid">
      <div class="article-content">
        <slot />
        <SourceList sourceIds={sourceIds} />
      </div>
      <aside class="article-aside" aria-label="Related content">
        {linkSections.map((section) => <SlugLinkList {...section} />)}
      </aside>
    </div>
  </article>
</BaseLayout>
