---
import StaticDiagram from '@components/StaticDiagram.astro';
import { glossaryTerms } from '@data/glossary';
import BaseLayout from '@layouts/BaseLayout.astro';

const glossaryVisualItems = [
  {
    value: String(glossaryTerms.length),
    label: 'Terms',
    detail: 'Concise definitions',
  },
  {
    value: 'Systems',
    label: 'Vocabulary lens',
    detail: 'Technical reading',
  },
  {
    value: 'Links',
    label: 'Article support',
    detail: 'Shared language',
  },
  {
    value: 'Neutral',
    label: 'Tone guardrail',
    detail: 'No hype terms',
  },
];
---

<BaseLayout
  title="Glossary"
  description="Definitions of automotive technology terms used throughout AutoEvolve."
>
  <section class="page-section page-hero">
    <p class="eyebrow">Definitions</p>
    <h1>Glossary</h1>
    <p>Short definitions for technical terms used across the archive.</p>
    <StaticDiagram
      variant="glossary"
      eyebrow="Definition visual"
      title="Glossary reading map"
      description="A visual summary of the glossary route, showing how concise definitions support technical reading across the archive."
      items={glossaryVisualItems}
    />
  </section>
  <section class="page-section glossary-list" aria-label="Glossary terms">
    {
      glossaryTerms.map((item) => (
        <dl class="glossary-term" id={item.slug}>
          <dt>{item.term}</dt>
          <dd>{item.definition}</dd>
        </dl>
      ))
    }
  </section>
</BaseLayout>
