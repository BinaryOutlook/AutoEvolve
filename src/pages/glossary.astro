---
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import { glossaryTerms } from '@data/glossary';
import BaseLayout from '@layouts/BaseLayout.astro';
import { mediaAssets } from '@lib/media';
---

<BaseLayout
  title="Glossary"
  description="Definitions of automotive technology terms used throughout AutoEvolve."
>
  <section class="page-section page-hero">
    <p class="eyebrow">Definitions</p>
    <h1>Glossary</h1>
    <p>Short definitions for technical terms used across the archive.</p>
    <SourcedMediaPanel
      asset={mediaAssets.electricCutaway}
      eyebrow="Vocabulary reference"
      title="Definitions stay attached to components"
      description="Glossary terms support technical reading across powertrains, fuel systems, controls, emissions hardware, and electric-drive articles."
      facts={[
        { label: 'Terms', value: String(glossaryTerms.length) },
        { label: 'Use', value: 'Shared technical language' },
        { label: 'Tone', value: 'Concise, neutral definitions' },
      ]}
      tags={['Definitions', 'Control Loops', 'Energy Paths']}
    />
  </section>
  <section class="page-section glossary-list" aria-label="Glossary terms">
    {
      glossaryTerms.map((item) => (
        <dl class="glossary-term" id={item.slug}>
          <dt>{item.term}</dt>
          <dd>{item.definition}</dd>
        </dl>
      ))
    }
  </section>
</BaseLayout>
