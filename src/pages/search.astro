---
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { mediaAssets } from '@lib/media';
---

<BaseLayout title="Search" description="Search AutoEvolve content.">
  <section class="page-section page-hero">
    <p class="eyebrow">Find content</p>
    <h1>Search</h1>
    <p>
      Search technology pages, eras, vehicle examples, controversies, glossary
      terms, and source records.
    </p>
    <SourcedMediaPanel
      asset={mediaAssets.hybridCutaway}
      eyebrow="Search reference"
      title="Search returns records, not recommendations"
      description="The static index helps readers find technologies, eras, examples, controversies, terms, and source records without changing the archive into a ranking engine."
      facts={[
        { label: 'Index', value: 'Pagefind static files' },
        { label: 'Query', value: 'Browser-side search' },
        { label: 'Fallback', value: 'Browse routes remain available' },
      ]}
      tags={['Static Search', 'Browseable Archive', 'No Backend']}
    />
  </section>
  <section class="page-section">
    <div class="search-shell">
      <div id="search"></div>
      <noscript
        >Search requires JavaScript after the site is built. Browse eras or
        technologies if scripting is unavailable.</noscript
      >
    </div>
  </section>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (window.PagefindUI) {
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
        });
      }
    });
  </script>
</BaseLayout>
