---
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { entrySlug, getPublicEntries } from '@lib/collections';
import { mediaForArchiveEntry } from '@lib/media';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const eras = await getPublicEntries('eras');
  return eras.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entrySlug(entry);
const media = mediaForArchiveEntry({
  collection: 'eras',
  slug,
  title: entry.data.title,
  dateRange: entry.data.dateRange,
  keyThemes: entry.data.keyThemes,
  relatedTechnologies: entry.data.relatedTechnologies,
  relatedVehicles: entry.data.relatedVehicles,
});
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  eyebrow="Historical era"
  status={entry.data.status}
  lastReviewed={entry.data.lastReviewed}
  sourceIds={entry.data.sources}
  metaItems={[{ label: 'Date range', value: entry.data.dateRange }]}
  linkSections={[
    {
      title: 'Related Technologies',
      basePath: '/technologies/',
      items: entry.data.relatedTechnologies,
    },
    {
      title: 'Vehicle Examples',
      basePath: '/vehicles/',
      items: entry.data.relatedVehicles,
    },
  ]}
>
  <SourcedMediaPanel
    asset={media.asset}
    eyebrow="Era reference image"
    title={media.title}
    description={media.description}
    facts={[
      { label: 'Date range', value: entry.data.dateRange },
      { label: 'Key themes', value: String(entry.data.keyThemes.length) },
      {
        label: 'Related technologies',
        value: String(entry.data.relatedTechnologies.length),
      },
      {
        label: 'Vehicle examples',
        value: String(entry.data.relatedVehicles.length),
      },
    ]}
    tags={media.tags}
  />
  <Content />
</ArticleLayout>
