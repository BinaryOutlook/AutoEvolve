---
import StaticDiagram from '@components/StaticDiagram.astro';
import ContentCard from '@components/ContentCard.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entrySlug, getPublicEntries, pathFor } from '@lib/collections';

const controversies = await getPublicEntries('controversies');
const controversyVisualItems = [
  {
    value: String(controversies.length),
    label: 'Case studies',
    detail: 'Documented events',
  },
  {
    value: String(
      new Set(controversies.flatMap((entry) => entry.data.affectedTechnologies))
        .size,
    ),
    label: 'Affected systems',
    detail: 'Technical context',
  },
  {
    value: String(
      new Set(controversies.flatMap((entry) => entry.data.relatedVehicles))
        .size,
    ),
    label: 'Vehicle links',
    detail: 'Examples only',
  },
  {
    value: 'Records',
    label: 'Regulatory lens',
    detail: 'Source-led framing',
  },
];
---

<BaseLayout
  title="Controversies"
  description="Technical and regulatory automotive controversy case studies."
>
  <section class="page-section page-hero">
    <p class="eyebrow">Case studies</p>
    <h1>Controversies</h1>
    <p>
      Controversy pages focus on documented events, technical background,
      regulatory context, and historical implications.
    </p>
    <StaticDiagram
      variant="controversies"
      eyebrow="Case-study visual"
      title="Controversy evidence flow"
      description="A visual summary of how controversy pages connect documented events, affected technologies, vehicle examples, and regulatory records."
      items={controversyVisualItems}
    />
  </section>
  <section class="page-section content-grid" aria-label="Controversy list">
    {
      controversies.map((entry) => (
        <ContentCard
          href={pathFor('controversies', entrySlug(entry))}
          title={entry.data.title}
          summary={entry.data.summary}
          meta={entry.data.dateRange}
        />
      ))
    }
  </section>
</BaseLayout>
