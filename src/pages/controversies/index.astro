---
import ContentCard from '@components/ContentCard.astro';
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entrySlug, getPublicEntries, pathFor } from '@lib/collections';
import { mediaAssets } from '@lib/media';

const controversies = await getPublicEntries('controversies');
---

<BaseLayout
  title="Controversies"
  description="Technical and regulatory automotive controversy case studies."
>
  <section class="page-section page-hero">
    <p class="eyebrow">Case studies</p>
    <h1>Controversies</h1>
    <p>
      Controversy pages focus on documented events, technical background,
      regulatory context, and historical implications.
    </p>
    <SourcedMediaPanel
      asset={mediaAssets.dieselCutaway}
      eyebrow="Case-study reference"
      title="Technical systems before blame narratives"
      description="Controversy pages stay anchored to documented events, affected hardware or software, regulatory findings, and clearly separated source roles."
      facts={[
        { label: 'Case studies', value: String(controversies.length) },
        {
          label: 'Affected systems',
          value: String(
            new Set(
              controversies.flatMap((entry) => entry.data.affectedTechnologies),
            ).size,
          ),
        },
        {
          label: 'Vehicle links',
          value: String(
            new Set(
              controversies.flatMap((entry) => entry.data.relatedVehicles),
            ).size,
          ),
        },
        { label: 'Lens', value: 'Regulatory records' },
      ]}
      tags={['Regulation', 'Software', 'Aftertreatment']}
    />
  </section>
  <section class="page-section content-grid" aria-label="Controversy list">
    {
      controversies.map((entry) => (
        <ContentCard
          href={pathFor('controversies', entrySlug(entry))}
          title={entry.data.title}
          summary={entry.data.summary}
          meta={entry.data.dateRange}
        />
      ))
    }
  </section>
</BaseLayout>
