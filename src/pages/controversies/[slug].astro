---
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { entrySlug, getPublicEntries } from '@lib/collections';
import { mediaForArchiveEntry } from '@lib/media';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const controversies = await getPublicEntries('controversies');
  return controversies.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entrySlug(entry);
const media = mediaForArchiveEntry({
  collection: 'controversies',
  slug,
  title: entry.data.title,
  dateRange: entry.data.dateRange,
  affectedTechnologies: entry.data.affectedTechnologies,
  relatedVehicles: entry.data.relatedVehicles,
});
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  eyebrow="Controversy"
  status={entry.data.status}
  lastReviewed={entry.data.lastReviewed}
  sourceIds={entry.data.sources}
  metaItems={[
    { label: 'Date range', value: entry.data.dateRange },
    { label: 'Regulatory context', value: entry.data.regulatoryContext },
  ]}
  linkSections={[
    {
      title: 'Affected Technologies',
      basePath: '/technologies/',
      items: entry.data.affectedTechnologies,
    },
    {
      title: 'Vehicle Examples',
      basePath: '/vehicles/',
      items: entry.data.relatedVehicles,
    },
  ]}
>
  <SourcedMediaPanel
    asset={media.asset}
    eyebrow="Case-study reference image"
    title={media.title}
    description={media.description}
    facts={[
      { label: 'Date range', value: entry.data.dateRange },
      {
        label: 'Affected technologies',
        value: String(entry.data.affectedTechnologies.length),
      },
      {
        label: 'Related vehicles',
        value: String(entry.data.relatedVehicles.length),
      },
    ]}
    tags={media.tags}
  />
  <Content />
</ArticleLayout>
