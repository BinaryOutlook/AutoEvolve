---
import GeneratedMediaPanel from '@components/GeneratedMediaPanel.astro';
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import SystemFlowPanel from '@components/SystemFlowPanel.astro';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { categoryLabel, entrySlug, getPublicEntries } from '@lib/collections';
import { generatedMediaForSlug } from '@lib/generated-media';
import { mediaForArchiveEntry } from '@lib/media';
import { getSystemFlow } from '@lib/system-flows';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const technologies = await getPublicEntries('technologies');
  return technologies.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entrySlug(entry);
const generatedMedia = generatedMediaForSlug(slug);
const systemFlow = getSystemFlow(slug);
const media = mediaForArchiveEntry({
  collection: 'technologies',
  slug,
  title: entry.data.title,
  category: entry.data.category,
  relatedTechnologies: entry.data.relatedTechnologies,
  relatedVehicles: entry.data.relatedVehicles,
});
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  eyebrow={categoryLabel(entry.data.category)}
  status={entry.data.status}
  lastReviewed={entry.data.lastReviewed}
  sourceIds={entry.data.sources}
  metaItems={[]}
  linkSections={[
    { title: 'Related Eras', basePath: '/eras/', items: entry.data.eras },
    {
      title: 'Related Technologies',
      basePath: '/technologies/',
      items: entry.data.relatedTechnologies,
    },
    {
      title: 'Vehicle Examples',
      basePath: '/vehicles/',
      items: entry.data.relatedVehicles,
    },
  ]}
>
  <SourcedMediaPanel
    asset={media.asset}
    eyebrow="Article reference image"
    title={media.title}
    description={media.description}
    facts={[
      { label: 'Category', value: categoryLabel(entry.data.category) },
      {
        label: 'Related eras',
        value: String(entry.data.eras.length),
      },
      {
        label: 'Related technologies',
        value: String(entry.data.relatedTechnologies.length),
      },
      {
        label: 'Vehicle examples',
        value: String(entry.data.relatedVehicles.length),
      },
    ]}
    tags={media.tags}
  />
  {generatedMedia && <GeneratedMediaPanel asset={generatedMedia} />}
  {systemFlow && <SystemFlowPanel flow={systemFlow} />}
  <Content />
</ArticleLayout>
