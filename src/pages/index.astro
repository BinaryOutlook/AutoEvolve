---
import CarSystemsExplorer from '@components/CarSystemsExplorer.astro';
import ContentCard from '@components/ContentCard.astro';
import SystemFamilyCards from '@components/SystemFamilyCards.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entrySlug, getPublicEntries, pathFor } from '@lib/collections';

const eras = await getPublicEntries('eras');
const technologies = await getPublicEntries('technologies');
const vehicles = await getPublicEntries('vehicles');
const controversies = await getPublicEntries('controversies');

const featuredTechnologies = technologies.filter((entry) =>
  [
    'four-stroke-engine',
    'diesel-engine',
    'hybrid-electric-vehicle',
    'battery-electric-vehicle',
  ].includes(entrySlug(entry)),
);
---

<BaseLayout title="AutoEvolve">
  <section class="page-section page-hero page-hero--v1">
    <div class="page-hero__copy">
      <p class="eyebrow">Automotive technology history</p>
      <h1>AutoEvolve</h1>
      <p>
        A neutral archive for understanding how engines, transmissions, fuel
        systems, EV motors, batteries, emissions hardware, and control networks
        fit together across automotive history.
      </p>
      <div class="hero-actions" aria-label="Primary archive routes">
        <a class="button button--primary" href="/technologies/">
          Explore systems
        </a>
        <a class="button button--ghost" href="/eras/">Browse eras</a>
      </div>
    </div>
    <div class="hero-ledger" aria-label="Archive counts">
      <dl>
        <div>
          <dt>Eras</dt>
          <dd>{eras.length}</dd>
        </div>
        <div>
          <dt>Technologies</dt>
          <dd>{technologies.length}</dd>
        </div>
        <div>
          <dt>Vehicle examples</dt>
          <dd>{vehicles.length}</dd>
        </div>
        <div>
          <dt>Case studies</dt>
          <dd>{controversies.length}</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="page-section">
    <CarSystemsExplorer />
  </section>

  <div class="page-section">
    <SystemFamilyCards />
  </div>

  <section class="page-section" aria-labelledby="archive-overview">
    <div class="section-heading">
      <h2 id="archive-overview">Archive routes</h2>
    </div>
    <div class="content-grid">
      <ContentCard
        href="/eras/"
        title={`${eras.length} Eras`}
        summary="Chronological periods from early self-propelled vehicles to software-defined electrified mobility."
      />
      <ContentCard
        href="/technologies/"
        title={`${technologies.length} Technologies`}
        summary="System-level explainers for propulsion, emissions, fuel, electric drive, diagnostics, and control."
      />
      <ContentCard
        href="/vehicles/"
        title={`${vehicles.length} Vehicle Examples`}
        summary="Selected models used only to illustrate broader engineering developments."
      />
      <ContentCard
        href="/controversies/"
        title={`${controversies.length} Case ${
          controversies.length === 1 ? 'Study' : 'Studies'
        }`}
        summary="Controversy pages framed through technical, procedural, and regulatory context."
      />
    </div>
  </section>

  <section class="page-section" aria-labelledby="starting-points">
    <div class="section-heading">
      <h2 id="starting-points">Mechanism starting points</h2>
      <a href="/eras/">Browse eras</a>
    </div>
    <div class="content-grid">
      {
        featuredTechnologies.map((entry) => (
          <ContentCard
            href={pathFor('technologies', entrySlug(entry))}
            title={entry.data.title}
            summary={entry.data.summary}
            eyebrow="Technology"
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
