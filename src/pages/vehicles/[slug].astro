---
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import ArticleLayout from '@layouts/ArticleLayout.astro';
import { entrySlug, getPublicEntries } from '@lib/collections';
import { mediaForArchiveEntry } from '@lib/media';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const vehicles = await getPublicEntries('vehicles');
  return vehicles.map((entry) => ({
    params: { slug: entrySlug(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const slug = entrySlug(entry);
const media = mediaForArchiveEntry({
  collection: 'vehicles',
  slug,
  title: entry.data.title,
  manufacturer: entry.data.manufacturer,
  productionPeriod: entry.data.productionPeriod,
  marketContext: entry.data.marketContext,
  relatedTechnologies: entry.data.relatedTechnologies,
});
---

<ArticleLayout
  title={entry.data.title}
  summary={entry.data.summary}
  eyebrow="Vehicle example"
  status={entry.data.status}
  lastReviewed={entry.data.lastReviewed}
  sourceIds={entry.data.sources}
  metaItems={[
    { label: 'Manufacturer', value: entry.data.manufacturer },
    { label: 'Production period', value: entry.data.productionPeriod },
    { label: 'Market context', value: entry.data.marketContext },
  ]}
  linkSections={[
    {
      title: 'Related Eras',
      basePath: '/eras/',
      items: entry.data.relatedEras,
    },
    {
      title: 'Technologies Illustrated',
      basePath: '/technologies/',
      items: entry.data.relatedTechnologies,
    },
  ]}
>
  <SourcedMediaPanel
    asset={media.asset}
    eyebrow="Vehicle reference image"
    title={media.title}
    description={media.description}
    facts={[
      { label: 'Manufacturer', value: entry.data.manufacturer },
      { label: 'Production period', value: entry.data.productionPeriod },
      {
        label: 'Technologies illustrated',
        value: String(entry.data.relatedTechnologies.length),
      },
    ]}
    tags={media.tags}
  />
  <Content />
</ArticleLayout>
