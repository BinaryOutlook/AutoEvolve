---
import ContentCard from '@components/ContentCard.astro';
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import { entrySlug, getPublicEntries, pathFor } from '@lib/collections';
import { mediaAssets, vehicleMediaBySlug } from '@lib/media';

const vehicles = await getPublicEntries('vehicles');
---

<BaseLayout
  title="Vehicle Examples"
  description="Vehicle examples used to explain broader automotive technologies."
>
  <section class="page-section page-hero">
    <p class="eyebrow">Examples, not reviews</p>
    <h1>Vehicle Examples</h1>
    <p>
      These pages use selected models to explain technology history. They avoid
      rankings, purchasing advice, and subjective review language.
    </p>
    <SourcedMediaPanel
      asset={mediaAssets.toyotaPrius}
      eyebrow="Example reference"
      title="Vehicles illustrate systems"
      description="Vehicle pages use models as concrete case studies for broader technical changes. They are not reviews, buying guides, or brand rankings."
      facts={[
        { label: 'Examples', value: String(vehicles.length) },
        {
          label: 'Manufacturers',
          value: String(
            new Set(vehicles.map((entry) => entry.data.manufacturer)).size,
          ),
        },
        {
          label: 'Technology links',
          value: String(
            new Set(vehicles.flatMap((entry) => entry.data.relatedTechnologies))
              .size,
          ),
        },
        {
          label: 'Era links',
          value: String(
            new Set(vehicles.flatMap((entry) => entry.data.relatedEras)).size,
          ),
        },
      ]}
      tags={['Examples', 'Neutrality', 'Systems First']}
    />
  </section>
  <section class="page-section content-grid" aria-label="Vehicle example list">
    {
      vehicles.map((entry) => {
        const slug = entrySlug(entry);
        const media =
          vehicleMediaBySlug[slug as keyof typeof vehicleMediaBySlug];

        return (
          <ContentCard
            href={pathFor('vehicles', slug)}
            title={entry.data.title}
            summary={entry.data.summary}
            eyebrow={entry.data.manufacturer}
            meta={entry.data.productionPeriod}
            imageSrc={media?.src}
            imageAlt={media?.alt}
          />
        );
      })
    }
  </section>
</BaseLayout>
