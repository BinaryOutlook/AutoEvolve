---
import SourcedMediaPanel from '@components/SourcedMediaPanel.astro';
import { sources } from '@data/sources';
import BaseLayout from '@layouts/BaseLayout.astro';
import { mediaAssets } from '@lib/media';

const sourceTypes = new Set(sources.map((source) => source.type));
---

<BaseLayout
  title="Sources"
  description="Source library and citation policy for AutoEvolve."
>
  <section class="page-section page-hero">
    <p class="eyebrow">Evidence</p>
    <h1>Sources</h1>
    <p>
      AutoEvolve prioritizes official, technical, academic, and archival
      references. Manufacturer material may support dates or specifications, but
      marketing claims should not become independent conclusions.
    </p>
    <SourcedMediaPanel
      asset={mediaAssets.dieselCutaway}
      eyebrow="Evidence reference"
      title="Every technical claim needs a role"
      description="Sources are organized by what they can support: technical mechanisms, regulatory findings, historical chronology, image attribution, or manufacturer-stated specifications."
      facts={[
        { label: 'Source records', value: String(sources.length) },
        { label: 'Source types', value: String(sourceTypes.size) },
        { label: 'Preferred support', value: 'Official and technical' },
        { label: 'Manufacturer use', value: 'Dates, specs, context' },
      ]}
      tags={['Evidence', 'Attribution', 'Source Roles']}
    />
  </section>
  <section class="page-section">
    <div class="content-grid">
      {
        sources.map((source) => (
          <article class="content-card">
            <p class="eyebrow">{source.type}</p>
            <h3>
              <a href={source.url}>{source.title}</a>
            </h3>
            <p>{source.organization}</p>
            <p>Accessed {source.accessedDate}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
