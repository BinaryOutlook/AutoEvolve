---
import StaticDiagram from '@components/StaticDiagram.astro';
import { sources } from '@data/sources';
import BaseLayout from '@layouts/BaseLayout.astro';

const sourceTypes = new Set(sources.map((source) => source.type));
const sourceVisualItems = [
  {
    value: String(sources.length),
    label: 'Source records',
    detail: 'Cited archive base',
  },
  {
    value: String(sourceTypes.size),
    label: 'Source types',
    detail: 'Evidence hierarchy',
  },
  {
    value: 'Primary',
    label: 'Preferred support',
    detail: 'Official and technical',
  },
  {
    value: 'Limited',
    label: 'Manufacturer use',
    detail: 'Dates/specs/context',
  },
];
---

<BaseLayout
  title="Sources"
  description="Source library and citation policy for AutoEvolve."
>
  <section class="page-section page-hero">
    <p class="eyebrow">Evidence</p>
    <h1>Sources</h1>
    <p>
      AutoEvolve prioritizes official, technical, academic, and archival
      references. Manufacturer material may support dates or specifications, but
      marketing claims should not become independent conclusions.
    </p>
    <StaticDiagram
      variant="sources"
      eyebrow="Evidence visual"
      title="Source support map"
      description="A visual summary of the source-library route, emphasizing record count, source-type diversity, and the preference for official or technical support."
      items={sourceVisualItems}
    />
  </section>
  <section class="page-section">
    <div class="content-grid">
      {
        sources.map((source) => (
          <article class="content-card">
            <p class="eyebrow">{source.type}</p>
            <h3>
              <a href={source.url}>{source.title}</a>
            </h3>
            <p>{source.organization}</p>
            <p>Accessed {source.accessedDate}</p>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
