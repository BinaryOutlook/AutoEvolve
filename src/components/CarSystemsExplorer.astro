  title: string;
  shortLabel: string;
  deck: string;
  role: string;
  flow: string;
  powertrains: string;
  x: number;
  y: number;
  links: ExplorerLink[];
};

type ExplorerMode = {
  id: string;
  label: string;
  sourceLabel: string;
  sourceUrl: string;
  image: string;
  originalImageUrl: string;
  alt: string;
  parts: SystemPart[];
};

