const initialMode = modes[0];
const initialPart = initialMode.parts[0];
const panelId = 'car-systems-panel';
---

<car-systems-explorer class="car-explorer">
  <div class="car-explorer__header">
    <div>
      <p class="eyebrow">Sourced system atlas</p>
      <h2>Real cutaway systems, inspected by powertrain</h2>
    </div>
    <p>
      Switch between AFDC cutaway images and select components to compare how
      energy, fluid, exhaust, and control paths change by architecture.
    </p>
  </div>

  <div class="car-explorer__tabs" aria-label="Powertrain view">
    {
      modes.map((mode, index) => (
        <button
          id={`atlas-tab-${mode.id}`}
          type="button"
          data-mode-tab={mode.id}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {mode.label}
        </button>
      ))
    }
  </div>

  <div class="car-explorer__workspace">
    <figure class="car-explorer__figure" id="atlas-image-panel">
      <div class="car-explorer__image-frame">
        <img
          data-atlas-image
          src={initialMode.image}
          alt={initialMode.alt}
          width="1000"
          height="626"
          loading="eager"
          decoding="async"
        />
        <div class="car-explorer__hotspots" data-hotspot-layer>
          {
            initialMode.parts.map((part, index) => (
              <button
                class="car-hotspot"
                type="button"
                style={`--hotspot-x: ${part.x}%; --hotspot-y: ${part.y}%;`}
                data-system-part
                data-part-index={String(index)}
                aria-controls={panelId}
                aria-pressed={index === 0 ? 'true' : 'false'}
                aria-label={part.title}
              >
                <span class="car-hotspot__number">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span>{part.shortLabel}</span>
              </button>
            ))
          }
        </div>
      </div>
      <figcaption data-atlas-caption>
        Source image:
        <a href={initialMode.sourceUrl}>{initialMode.sourceLabel}</a>.
        Downloaded from
        <a href={initialMode.originalImageUrl}>AFDC high-resolution image</a>.
      </figcaption>
    </figure>

    <article class="car-explorer__panel" id={panelId} aria-live="polite">
      <p class="eyebrow" data-panel-mode>{initialMode.label}</p>
      <h3 data-panel-title>{initialPart.title}</h3>
      <p data-panel-deck>{initialPart.deck}</p>
      <dl>
        <div>
          <dt>System role</dt>
          <dd data-panel-role>{initialPart.role}</dd>
        </div>
        <div>
          <dt>Flow path</dt>
          <dd data-panel-flow>{initialPart.flow}</dd>
        </div>
        <div>
          <dt>Applies to</dt>
          <dd data-panel-powertrains>{initialPart.powertrains}</dd>
        </div>
      </dl>
      <div class="car-explorer__links">
        <p class="eyebrow">Related archive guides</p>
        <ul data-panel-links>
          {
            initialPart.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </div>

  <p class="car-explorer__rights">
    Images and component baselines are sourced from the U.S. Department of
    Energy Alternative Fuels Data Center. DOE web policies note that
    public-domain images may be used without permission, while third-party
    material can carry separate rights.
    <a href="https://www.energy.gov/node/268153">Review DOE web policies</a>.
  </p>
</car-systems-explorer>

<script define:vars={{ modes }} is:inline>
  class CarSystemsExplorer extends HTMLElement {
    connectedCallback() {
      const modeTabs = Array.from(this.querySelectorAll('[data-mode-tab]'));
      const image = this.querySelector('[data-atlas-image]');
      const caption = this.querySelector('[data-atlas-caption]');
      const hotspotLayer = this.querySelector('[data-hotspot-layer]');
      const panelMode = this.querySelector('[data-panel-mode]');
      const title = this.querySelector('[data-panel-title]');
      const deck = this.querySelector('[data-panel-deck]');
      const role = this.querySelector('[data-panel-role]');
      const flow = this.querySelector('[data-panel-flow]');
      const powertrains = this.querySelector('[data-panel-powertrains]');
      const links = this.querySelector('[data-panel-links]');

      if (
        modeTabs.length === 0 ||
        image === null ||
        caption === null ||
        hotspotLayer === null ||
        panelMode === null ||
        title === null ||
        deck === null ||
        role === null ||
        flow === null ||
        powertrains === null ||
        links === null
      ) {
        return;
      }

      let activeMode = modes[0];

      modes.forEach((mode) => {
        const preload = new Image();
        preload.src = mode.image;
      });

      const renderLinks = (part) => {
        links.replaceChildren(
          ...part.links.map((link) => {
            const item = document.createElement('li');
            const anchor = document.createElement('a');
            anchor.href = link.href;
            anchor.textContent = link.label;
            item.append(anchor);
            return item;
          }),
        );
      };

      const selectPart = (part, selectedButton) => {
        for (const button of hotspotLayer.querySelectorAll(
          '[data-system-part]',
        )) {
          button.setAttribute(
            'aria-pressed',
            String(button === selectedButton),
          );
        }

        panelMode.textContent = activeMode.label;
        title.textContent = part.title;
        deck.textContent = part.deck;
        role.textContent = part.role;
        flow.textContent = part.flow;
        powertrains.textContent = part.powertrains;
        renderLinks(part);
      };

      const renderHotspots = () => {
        hotspotLayer.replaceChildren(
          ...activeMode.parts.map((part, index) => {
            const button = document.createElement('button');
            const number = document.createElement('span');
            const label = document.createElement('span');

            button.className = 'car-hotspot';
            button.type = 'button';
            button.style.setProperty('--hotspot-x', `${part.x}%`);
            button.style.setProperty('--hotspot-y', `${part.y}%`);
            button.dataset.systemPart = '';
            button.dataset.partIndex = String(index);
            button.setAttribute('aria-controls', 'car-systems-panel');
            button.setAttribute('aria-pressed', String(index === 0));
            button.setAttribute('aria-label', part.title);

            number.className = 'car-hotspot__number';
            number.textContent = String(index + 1).padStart(2, '0');
            label.textContent = part.shortLabel;

            button.append(number, label);
            button.addEventListener('click', () => selectPart(part, button));
            return button;
          }),
        );

        const firstButton = hotspotLayer.querySelector('[data-system-part]');
        const firstPart = activeMode.parts[0];

        if (firstButton !== null && firstPart !== undefined) {
          selectPart(firstPart, firstButton);
        }
      };

      const selectMode = (modeId) => {
        const nextMode = modes.find((mode) => mode.id === modeId);

        if (nextMode === undefined) {
          return;
        }

        activeMode = nextMode;
        image.src = activeMode.image;
        image.alt = activeMode.alt;
        const sourceAnchor = document.createElement('a');
        const imageAnchor = document.createElement('a');
        sourceAnchor.href = activeMode.sourceUrl;
        sourceAnchor.textContent = activeMode.sourceLabel;
        imageAnchor.href = activeMode.originalImageUrl;
        imageAnchor.textContent = 'AFDC high-resolution image';
        caption.replaceChildren(
          'Source image: ',
          sourceAnchor,
          '. Downloaded from ',
          imageAnchor,
          '.',
        );

        for (const tab of modeTabs) {
          const selected = tab.dataset.modeTab === activeMode.id;
          tab.setAttribute('aria-pressed', String(selected));
        }

        renderHotspots();
      };

      modeTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          selectMode(tab.dataset.modeTab ?? '');
        });
      });

      renderHotspots();
    }
  }

  if (!customElements.get('car-systems-explorer')) {
    customElements.define('car-systems-explorer', CarSystemsExplorer);
  }
</script>
