---
import {
  labelFromSlug,
  pickVisualItems,
  technologyVisualForSlug,
  visualId,
  wrapLabel,
} from '@lib/visuals';

type Stage = {
  label: string;
  detail: string;
};

type VisualModel = {
  eyebrow: string;
  heading: string;
  description: string;
  stages: readonly Stage[];
  tags: string[];
  caption: string;
  grounding: string;
};

type EraProps = {
  kind: 'era';
  title: string;
  summary: string;
  dateRange: string;
  keyThemes: readonly string[];
  relatedTechnologies: readonly string[];
  relatedVehicles: readonly string[];
};

type TechnologyProps = {
  kind: 'technology';
  title: string;
  summary: string;
  slug: string;
  category: string;
  eras: readonly string[];
  relatedTechnologies: readonly string[];
  relatedVehicles: readonly string[];
};

type VehicleProps = {
  kind: 'vehicle';
  title: string;
  summary: string;
  manufacturer: string;
  productionPeriod: string;
  marketContext: string;
  illustrates: readonly string[];
  relatedTechnologies: readonly string[];
};

type ControversyProps = {
  kind: 'controversy';
  title: string;
  summary: string;
  dateRange: string;
  affectedTechnologies: readonly string[];
  relatedVehicles: readonly string[];
  regulatoryContext: string;
};

type Props = EraProps | TechnologyProps | VehicleProps | ControversyProps;

type DesktopStageNode = Stage & {
  x: number;
  y: number;
  width: number;
  height: number;
  labelLines: string[];
  detailLines: string[];
};

type MobileStageNode = Stage & {
  x: number;
  y: number;
  width: number;
  height: number;
  labelLines: string[];
  detailLines: string[];
};

const props = Astro.props;
const articleDiagramCaption =
  "Original AutoEvolve diagram based on this page's metadata, content relationships, and cited-source context where present. No external image license is required.";
const technologyDiagramCaption =
  'Original AutoEvolve diagram: mechanism map curated for this technology page from the article topic and source-backed technical context. No external image license is required.';

function tagsFromSlugs(items: readonly string[], fallback: readonly string[]) {
  return pickVisualItems(items, fallback, 5).map(labelFromSlug);
}

function buildVisualModel(visualProps: Props): VisualModel {
  switch (visualProps.kind) {
    case 'era': {
      const themes = pickVisualItems(
        visualProps.keyThemes,
        ['technical context', 'system transition'],
        3,
      );
      const relatedSystems = tagsFromSlugs(visualProps.relatedTechnologies, [
        'technology links',
      ]);

      return {
        eyebrow: 'Era context panel',
        heading: `${visualProps.title} at a glance`,
        description: `${visualProps.title} is diagrammed as a chronological context panel from ${visualProps.dateRange}, with key themes and related systems drawn from the article metadata. ${visualProps.summary}`,
        stages: [
          {
            label: visualProps.dateRange,
            detail: 'Chronological boundary',
          },
          {
            label: themes[0] ?? 'Technical shift',
            detail: themes[1] ?? 'Adoption pressure',
          },
          {
            label: themes[2] ?? 'Archive links',
            detail: `${visualProps.relatedTechnologies.length} technologies · ${visualProps.relatedVehicles.length} vehicles`,
          },
        ],
        tags: [...themes, ...relatedSystems].slice(0, 6),
        caption: articleDiagramCaption,
        grounding:
          'Chronology, themes, and links orient the reader before the article text.',
      };
    }
    case 'technology': {
      const blueprint = technologyVisualForSlug(visualProps.slug);

      return {
        eyebrow: blueprint.theme,
        heading: `${visualProps.title} mechanism map`,
        description: `${visualProps.title} is shown with curated, page-specific mechanism stages: ${blueprint.stages
          .map((stage) => `${stage.label} (${stage.detail})`)
          .join(' to ')}. ${blueprint.focus}`,
        stages: blueprint.stages,
        tags: blueprint.stages.map((stage) => stage.label),
        caption: technologyDiagramCaption,
        grounding: blueprint.grounding,
      };
    }
    case 'vehicle': {
      const illustratedSystems = pickVisualItems(
        visualProps.illustrates,
        visualProps.relatedTechnologies,
        4,
      );

      return {
        eyebrow: 'Vehicle example lens',
        heading: `${visualProps.title} example card`,
        description: `${visualProps.title} is shown as an example-first diagram connecting manufacturer, production period, market context, and the technologies the page uses it to illustrate. ${visualProps.summary}`,
        stages: [
          {
            label: visualProps.manufacturer,
            detail: visualProps.productionPeriod,
          },
          { label: visualProps.title, detail: visualProps.marketContext },
          {
            label: 'Technology illustrated',
            detail: illustratedSystems[0] ?? 'System example',
          },
        ],
        tags: [
          ...illustratedSystems,
          ...visualProps.relatedTechnologies.map(labelFromSlug),
        ].slice(0, 6),
        caption: articleDiagramCaption,
        grounding:
          'The vehicle visual keeps the example tied to the technology it illustrates.',
      };
    }
    case 'controversy': {
      const affectedSystems = tagsFromSlugs(visualProps.affectedTechnologies, [
        'affected systems',
      ]);

      return {
        eyebrow: 'Investigation flow',
        heading: `${visualProps.title} evidence path`,
        description: `${visualProps.title} is shown as a documented case flow from event timing, through affected technical systems, to regulatory context and related vehicle examples. ${visualProps.summary}`,
        stages: [
          { label: visualProps.dateRange, detail: 'Documented period' },
          {
            label: affectedSystems[0] ?? 'Affected systems',
            detail: `${visualProps.affectedTechnologies.length} technology links`,
          },
          {
            label: 'Regulatory record',
            detail: visualProps.regulatoryContext,
          },
        ],
        tags: [
          ...affectedSystems,
          ...visualProps.relatedVehicles.map(labelFromSlug),
        ].slice(0, 6),
        caption: articleDiagramCaption,
        grounding:
          'The case flow separates timing, affected systems, and the regulatory record.',
      };
    }
    default: {
      const exhaustiveCheck: never = visualProps;
      throw new Error(`Unsupported article visual kind: ${exhaustiveCheck}`);
    }
  }
}

const model = buildVisualModel(props);
const idBase = visualId(`${props.kind}-${props.title}`);
const titleId = `${idBase}-title`;
const descId = `${idBase}-desc`;
const mobileTitleId = `${idBase}-mobile-title`;
const mobileDescId = `${idBase}-mobile-desc`;
const captionId = `${idBase}-caption`;
const desktopArrowId = `${idBase}-arrow-desktop`;
const mobileArrowId = `${idBase}-arrow-mobile`;

const desktopStageGap = model.stages.length === 4 ? 36 : 70;
const desktopStageWidth =
  (880 - desktopStageGap * (model.stages.length - 1)) / model.stages.length;
const desktopLabelLength = model.stages.length === 4 ? 18 : 26;
const desktopDetailLength = model.stages.length === 4 ? 22 : 32;
const desktopStageNodes: DesktopStageNode[] = model.stages.map(
  (stage, index) => ({
    x: 60 + index * (desktopStageWidth + desktopStageGap),
    y: 86,
    width: desktopStageWidth,
    height: 142,
    labelLines: wrapLabel(stage.label, desktopLabelLength, 3),
    detailLines: wrapLabel(stage.detail, desktopDetailLength, 2),
    ...stage,
  }),
);
const desktopRailSegments = desktopStageNodes
  .slice(0, -1)
  .map((node, index) => ({
    x1: node.x + node.width,
    x2: desktopStageNodes[index + 1]?.x ?? node.x + node.width,
  }));
const desktopGroundingLines = wrapLabel(model.grounding, 96, 2);

const mobileStageX = 32;
const mobileStageWidth = 296;
const mobileStageHeight = 106;
const mobileStagePitch = 134;
const mobileStageNodes: MobileStageNode[] = model.stages.map(
  (stage, index) => ({
    x: mobileStageX,
    y: 74 + index * mobileStagePitch,
    width: mobileStageWidth,
    height: mobileStageHeight,
    labelLines: wrapLabel(stage.label, 27, 3),
    detailLines: wrapLabel(stage.detail, 34, 2),
    ...stage,
  }),
);
const mobileGroundingLines = wrapLabel(model.grounding, 36, 3);
const mobileGroundingY = 74 + model.stages.length * mobileStagePitch + 8;
const mobileGroundingHeight = 32 + mobileGroundingLines.length * 16;
const mobileViewBoxHeight = mobileGroundingY + mobileGroundingHeight + 24;
---

<figure class={`archive-visual archive-visual--${props.kind}`}>
  <div class="archive-visual__intro">
    <p class="eyebrow">{model.eyebrow}</p>
    <h2>{model.heading}</h2>
  </div>
  <div class="archive-visual__canvas">
    <svg
      class="archive-visual__svg archive-visual__svg--desktop"
      viewBox="0 0 1000 360"
      role="img"
      aria-labelledby={titleId}
      aria-describedby={descId}
    >
      <title id={titleId}>{model.heading}</title>
      <desc id={descId}>{model.description}</desc>
      <defs>
        <marker
          id={desktopArrowId}
          markerWidth="10"
          markerHeight="10"
          refX="8"
          refY="5"
          orient="auto"
          markerUnits="strokeWidth"
        >
          <path d="M0,0 L10,5 L0,10 z"></path>
        </marker>
      </defs>
      {
        desktopRailSegments.map((segment) => (
          <path
            class="archive-visual__rail"
            d={`M${segment.x1} 157 H${segment.x2}`}
            marker-end={`url(#${desktopArrowId})`}
          />
        ))
      }
      {
        desktopStageNodes.map((node, index) => (
          <g class="archive-visual__node">
            <rect
              x={node.x}
              y={node.y}
              width={node.width}
              height={node.height}
              rx="14"
            />
            <circle cx={node.x + 24} cy={node.y + 25} r="12" />
            <text
              class="archive-visual__node-index"
              x={node.x + 24}
              y={node.y + 30}
            >
              {index + 1}
            </text>
            <text
              class="archive-visual__node-label"
              x={node.x + node.width / 2}
              y={node.y + 62 - (node.labelLines.length - 1) * 8}
            >
              {node.labelLines.map((line, lineIndex) => (
                <tspan
                  x={node.x + node.width / 2}
                  dy={lineIndex === 0 ? 0 : 16}
                >
                  {line}
                </tspan>
              ))}
            </text>
            <text
              class="archive-visual__node-detail"
              x={node.x + node.width / 2}
              y={node.y + 114 - (node.detailLines.length - 1) * 7}
            >
              {node.detailLines.map((line, lineIndex) => (
                <tspan
                  x={node.x + node.width / 2}
                  dy={lineIndex === 0 ? 0 : 14}
                >
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        ))
      }
      <g class="archive-visual__grounding">
        <rect x="110" y="276" width="780" height="54" rx="27"></rect>
        <text x="500" y={302 - (desktopGroundingLines.length - 1) * 7}>
          {
            desktopGroundingLines.map((line, lineIndex) => (
              <tspan x="500" dy={lineIndex === 0 ? 0 : 15}>
                {line}
              </tspan>
            ))
          }
        </text>
      </g>
    </svg>
    <svg
      class="archive-visual__svg archive-visual__svg--mobile"
      viewBox={`0 0 360 ${mobileViewBoxHeight}`}
      role="img"
      aria-labelledby={mobileTitleId}
      aria-describedby={mobileDescId}
    >
      <title id={mobileTitleId}>{model.heading}</title>
      <desc id={mobileDescId}>{model.description}</desc>
      <defs>
        <marker
          id={mobileArrowId}
          markerWidth="10"
          markerHeight="10"
          refX="8"
          refY="5"
          orient="auto"
          markerUnits="strokeWidth"
        >
          <path d="M0,0 L10,5 L0,10 z"></path>
        </marker>
      </defs>
      {
        mobileStageNodes.slice(0, -1).map((node, index) => {
          const nextNode = mobileStageNodes[index + 1];
          return (
            nextNode !== undefined && (
              <path
                class="archive-visual__rail"
                d={`M180 ${node.y + node.height} V${nextNode.y}`}
                marker-end={`url(#${mobileArrowId})`}
              />
            )
          );
        })
      }
      {
        mobileStageNodes.map((node, index) => (
          <g class="archive-visual__node archive-visual__node--mobile">
            <rect
              x={node.x}
              y={node.y}
              width={node.width}
              height={node.height}
              rx="14"
            />
            <circle cx={node.x + 25} cy={node.y + 30} r="12" />
            <text
              class="archive-visual__node-index"
              x={node.x + 25}
              y={node.y + 35}
            >
              {index + 1}
            </text>
            <text
              class="archive-visual__node-label archive-visual__node-label--mobile"
              x={node.x + 52}
              y={node.y + 31 - (node.labelLines.length - 1) * 7}
            >
              {node.labelLines.map((line, lineIndex) => (
                <tspan x={node.x + 52} dy={lineIndex === 0 ? 0 : 15}>
                  {line}
                </tspan>
              ))}
            </text>
            <text
              class="archive-visual__node-detail archive-visual__node-detail--mobile"
              x={node.x + 52}
              y={node.y + 78 - (node.detailLines.length - 1) * 7}
            >
              {node.detailLines.map((line, lineIndex) => (
                <tspan x={node.x + 52} dy={lineIndex === 0 ? 0 : 14}>
                  {line}
                </tspan>
              ))}
            </text>
          </g>
        ))
      }
      <g class="archive-visual__grounding">
        <rect
          x="32"
          y={mobileGroundingY}
          width="296"
          height={mobileGroundingHeight}
          rx="24"
        >
        </rect>
        <text
          x="180"
          y={mobileGroundingY + 32 - (mobileGroundingLines.length - 1) * 7}
        >
          {
            mobileGroundingLines.map((line, lineIndex) => (
              <tspan x="180" dy={lineIndex === 0 ? 0 : 15}>
                {line}
              </tspan>
            ))
          }
        </text>
      </g>
    </svg>
  </div>
  <figcaption id={captionId}>{model.caption}</figcaption>
  <ul
    class="archive-visual__tags"
    aria-label="Concept labels represented in this diagram"
  >
    {model.tags.map((tag) => <li>{tag}</li>)}
  </ul>
</figure>
