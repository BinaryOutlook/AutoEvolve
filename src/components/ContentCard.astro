---
type Props = {
  href: string;
  title: string;
  summary: string;
  eyebrow?: string;
  meta?: string;
  imageAlt?: string;
  imagePriority?: boolean;
  imageSrc?: string;
};

const {
  href,
  title,
  summary,
  eyebrow,
  meta,
  imageAlt,
  imagePriority,
  imageSrc,
} = Astro.props;
---

<article class="content-card">
  <a
    class:list={[
      'content-card__anchor',
      imageSrc && imageAlt && 'content-card__anchor--media',
    ]}
    href={href}
  >
    {
      imageSrc && imageAlt && (
        <img
          class="content-card__thumb"
          src={imageSrc}
          alt={imageAlt}
          loading={imagePriority ? 'eager' : 'lazy'}
          decoding="async"
          fetchpriority={imagePriority ? 'high' : 'auto'}
        />
      )
    }
    <span class="content-card__body">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <span class="content-card__title">{title}</span>
      <span class="content-card__summary">{summary}</span>
    </span>
    {meta && <span class="content-card__meta">{meta}</span>}
  </a>
</article>
