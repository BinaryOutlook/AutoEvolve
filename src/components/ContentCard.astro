---
type Props = {
  href: string;
  title: string;
  summary: string;
  eyebrow?: string;
  meta?: string;
  imageAlt?: string;
  imageSrc?: string;
};

const { href, title, summary, eyebrow, meta, imageAlt, imageSrc } =
  Astro.props;
---

<article class="content-card">
  <a
    class:list={[
      'content-card__anchor',
      imageSrc && imageAlt && 'content-card__anchor--media',
    ]}
    href={href}
  >
    {
      imageSrc && imageAlt && (
        <img
          class="content-card__thumb"
          src={imageSrc}
          alt={imageAlt}
          loading="eager"
          decoding="sync"
        />
      )
    }
    <span class="content-card__body">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <span class="content-card__title">{title}</span>
      <span class="content-card__summary">{summary}</span>
    </span>
    {meta && <span class="content-card__meta">{meta}</span>}
  </a>
</article>
